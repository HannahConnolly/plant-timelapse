GEMINI_API_KEY="GENAI_KEY_HERE"
DISCORD_PHOTO_WEBHOOK_URL="https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN"
DISCORD_SENSOR_WEBHOOK_URL="https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN"
DISCORD_GEMINI_WEBHOOK_URL="https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN"
DISCORD_ANIMATION_WEBHOOK_URL="https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN"

# AWS S3 backup (optional; leave unset to skip uploads).
# Credentials come from `aws configure` (~/.aws), never from this file.
AWS_S3_BUCKET="plant-timelapse-yourname"

# AWS IoT Core (optional; leave AWS_IOT_ENDPOINT unset to skip publishing).
# Endpoint: IoT Core > Connect > Domain configurations > iot:Data-ATS, or run
#   aws iot describe-endpoint --endpoint-type iot:Data-ATS
AWS_IOT_ENDPOINT="xxxxxxxxxxxxxx-ats.iot.us-east-2.amazonaws.com"
# Must match the Thing name and the client ID allowed by the IoT policy (default: plant-pi)
AWS_IOT_THING_NAME="plant-pi"
# Folder holding certificate.pem.crt, private.pem.key and AmazonRootCA1.pem (default: ~/.plant-iot)
AWS_IOT_CERT_DIR="~/.plant-iot"
